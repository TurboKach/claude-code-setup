{
  "env": {
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "BASH_DEFAULT_TIMEOUT_MS": "900000",
    "CODEX_REVIEW_MODEL": "gpt-6-sol",
    "CODEX_REVIEW_EFFORT": "medium"
  },
  "model": "opus",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "worktree": {
    "baseRef": "head"
  },
  "bashOutputMaxChars": 30000,
  "bashEditDiffEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stack-update-check.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/session-name.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/subagent-no-background.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
